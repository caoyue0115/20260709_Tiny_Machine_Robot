APP_ENV=dev
HOST=0.0.0.0
PORT=8010
PUBLIC_BASE_URL=http://localhost:8010
REDIS_URL=redis://redis:6379/0
SQLITE_PATH=./data/tasks.db
QUEUE_NAME=tiny_coffee_tasks
ENABLED_SKILLS=idiom_game
IDIOM_GAME_TTL_SECONDS=900
IDIOM_GAME_ROBOT_DIFFICULTY=easy
IDIOM_GAME_TARGET_USER_TURNS=0
IDIOM_GAME_LLM_JUDGE_ENABLED=true
IDIOM_GAME_LLM_JUDGE_MIN_CONFIDENCE=0.8

ASR_PROVIDER=dashscope
ASR_FALLBACK_PROVIDER=dashscope
