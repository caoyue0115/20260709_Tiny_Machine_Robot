LLM_PROVIDER=dashscope
LLM_MODEL=qwen3.5-flash-2026-02-23
REALTIME_ENABLED=true
REALTIME_AUDIO_ENABLE_OPUS=true
REALTIME_TTS_PROVIDER=self_hosted
SELF_HOSTED_TTS_WS_URL=ws://127.0.0.1:18122/tts/realtime
SELF_HOSTED_TTS_HEALTH_URL=http://127.0.0.1:18122/health
SELF_HOSTED_TTS_MODEL=qwen3-tts-base-1_7b
SELF_HOSTED_TTS_VOICE=clone_coffee_20s_v1
SELF_HOSTED_TTS_POST_ROLL_MS=500
SELF_HOSTED_TTS_FIXED_TEMPO=0.9
STATIC_AUDIO_ENABLED=true
STATIC_AUDIO_DIR=./data/static_audio
STATIC_AUDIO_CHUNK_SIZE=4096

VOLCENGINE_SPEECH_APP_ID=
VOLCENGINE_SPEECH_ACCESS_TOKEN=
